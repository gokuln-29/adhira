# Copy to `.env` on the VPS (never commit the real file).

# --- Your domain (for HTTPS) ---
DOMAIN=example.com
ACME_EMAIL=you@example.com

# --- Supabase (Project Settings -> API). These three NEXT_PUBLIC_* are baked
#     into the build, so re-run `docker compose ... up -d --build` after changing them.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://example.com
# SECRET: server only. Bypasses row-level security. Never share or commit.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (leave empty to accept Cash on Delivery only) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (optional): order confirmations to customers + new-order alerts to you.
#     Create a free account at resend.com, verify your domain, then fill these in.
#     Leave RESEND_API_KEY empty to send no emails.
RESEND_API_KEY=
EMAIL_FROM=Flowers N Plants <orders@example.com>
# Who gets "new order" and "new enquiry" alerts (defaults to the contact email in Admin > Settings)
ORDER_NOTIFY_EMAIL=

