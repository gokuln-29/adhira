# /etc/adhira/backup.env  (root:root, chmod 600). No secrets are stored in the repo.
# restic repo on Google Drive via rclone (run `rclone config` as root to create the
# `gdrive` remote with a dedicated backup-only Google account that has MFA).
RESTIC_REPOSITORY=rclone:gdrive:adhira-restic
RESTIC_PASSWORD_FILE=/etc/adhira/restic.pass        # 600; ALSO keep a copy in the password manager
MYSQL_DEFAULTS_FILE=/etc/adhira/backup.cnf          # [client] user=adhira_backup / password=... (600)
BACKUP_DB=adhira
# Weekly media copy: R2 -> encrypted remote (rclone crypt layered on another provider/account).
#   rclone remotes: `r2` (type s3, provider Cloudflare) and `media-crypt` (type crypt -> gdrive:adhira-media)
MEDIA_SOURCE_REMOTE=r2:adhira-media
MEDIA_BACKUP_REMOTE=media-crypt:
# Alerts (see monitoring/notify.sh)
ALERT_EMAIL=ops@adhiraflowers.ae
BREVO_API_KEY=
ALERT_FROM=alerts@adhiraflowers.ae
# Optional dead-man's-switch (healthchecks.io): pinged on success, alerts you if pings STOP.
HEALTHCHECK_URL=
