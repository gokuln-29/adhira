# HTTPS reverse proxy. Caddy obtains and renews Let's Encrypt certificates for
# DOMAIN automatically. Requirements: DNS A record -> this server's IP, and
# ports 80 + 443 open.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000 {
		# Overwrite any client-supplied value: rate limits trust this header.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
