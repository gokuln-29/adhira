# --- Supabase ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe ---
# Checkout uses Stripe's hosted page (Checkout Sessions), so only the secret
# key and webhook secret are actually read by app code today.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Not currently used (no Stripe.js/Elements on the client) — kept for when a
# future embedded payment flow needs it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Tabby (BNPL) ---
TABBY_SECRET_KEY=
TABBY_PUBLIC_KEY=
TABBY_MERCHANT_CODE=

# --- Tamara (BNPL) ---
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=

# --- WhatsApp (payment link sharing, optional) ---
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
