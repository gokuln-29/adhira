# Copy to .env.local for development. On the VPS the same names live in
# /etc/adhira/env (root:adhira 0640). NEVER commit real values.
# NEXT_PUBLIC_* are compiled into the browser bundle at build time.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # production: https://adhiraflowers.ae

# --- MySQL (127.0.0.1 only) ---
# Runtime app user: SELECT/INSERT/UPDATE/DELETE only.
DATABASE_URL=mysql://adhira_app:CHANGE_ME@127.0.0.1:3306/adhira
# Schema owner, used ONLY by `npm run db:migrate` / deploy.sh and admin:create.
DATABASE_MIGRATE_URL=mysql://adhira_migrate:CHANGE_ME@127.0.0.1:3306/adhira
DATABASE_POOL_SIZE=10

# --- Auth ---
# Random, >= 32 chars (openssl rand -hex 32). Peppers OTP hashes and encrypts TOTP secrets at rest.
# Rotating it signs everyone out of MFA enrolment: re-enrol after changing.
AUTH_SECRET=

# --- Email (Brevo transactional API) ---
# Sign-in codes, order confirmations, new-order/enquiry alerts. Empty key = no email
# (in development the sign-in code is printed to the server log instead).
BREVO_API_KEY=
EMAIL_FROM=orders@adhiraflowers.ae                # a sender verified in Brevo
EMAIL_FROM_NAME=Adhira Flowers
ORDER_NOTIFY_EMAIL=                               # defaults to the contact email in Admin > Settings
ALERT_EMAIL=                                      # where payment/webhook alerts go (falls back to the two above)

# --- Cloudflare R2 (images) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=                                 # scoped API token: Object Read & Write on this bucket only
R2_SECRET_ACCESS_KEY=
R2_BUCKET=adhira-media
# Custom domain attached to the bucket (public read), e.g. https://media.adhiraflowers.ae
MEDIA_PUBLIC_URL=
# Local MinIO only (leave empty for real R2):
R2_ENDPOINT=

# --- Invoice PDFs (headless Chrome) ---
# Path to a Chrome/Chromium binary. Installed by deploy/scripts/provision.sh into /opt/adhira-chrome.
# Without it the invoice page still works (print to PDF) and emails carry a link instead of an attachment.
CHROME_PATH=
# Only if the app can't reach itself on 127.0.0.1:$PORT (default).
INTERNAL_URL=

# --- Stripe (REQUIRED for checkout: card is the only payment method) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Tabby / Tamara (scaffold only, see src/lib/bnpl/README.md) ---
TABBY_SECRET_KEY=
TABBY_PUBLIC_KEY=
TABBY_MERCHANT_CODE=
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=

# --- WhatsApp (payment link sharing, optional) ---
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
